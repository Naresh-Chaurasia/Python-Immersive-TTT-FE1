# Copy this file to .env and adjust as needed. Never commit a real .env.

# Logging
LOG_LEVEL=DEBUG

# MCP transport: stdio (local dev, e.g. Claude Desktop) or streamable-http (Docker Compose demo)
MCP_TRANSPORT=stdio

# Ports used only when MCP_TRANSPORT=streamable-http
MCP_PORT=8001
HEALTH_PORT=8011

# Shared database path (set automatically by docker-compose.yml to /app/data/neobank.db)
NEOBANK_DB_PATH=./neobank.db

SERVICE_NAME=accounts_server

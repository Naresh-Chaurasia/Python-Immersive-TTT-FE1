FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY logging_config.py database.py guardrails.py models.py health.py ./
COPY servers/products_server.py servers/products_server.py

ENV LOG_LEVEL=DEBUG
ENV MCP_TRANSPORT=streamable-http
ENV MCP_PORT=8002
ENV HEALTH_PORT=8012
ENV SERVICE_NAME=products_server

EXPOSE 8002 8012

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8012/health', timeout=2)" || exit 1

CMD ["python3", "servers/products_server.py"]
